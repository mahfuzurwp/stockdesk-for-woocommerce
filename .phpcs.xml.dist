<?xml version="1.0"?>
<ruleset name="StockDesk for WooCommerce">
	<description>Coding standard for the StockDesk for WooCommerce plugin.</description>

	<file>.</file>

	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<config name="minimum_supported_wp_version" value="6.2"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="stockdesk-for-woocommerce"/>
			</property>
		</properties>
	</rule>

	<!--
	This plugin intentionally uses two prefixes: SDFW_/sdfw_ for internal
	classes, options, and transients, and stockdesk_ for the public
	action/filter hooks it exposes for site builders to extend.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="sdfw"/>
				<element value="SDFW"/>
				<element value="stockdesk"/>
			</property>
		</properties>
	</rule>

	<!-- manage_woocommerce is registered by WooCommerce core, not by this plugin. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>
</ruleset>
